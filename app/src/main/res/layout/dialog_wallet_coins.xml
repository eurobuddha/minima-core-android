<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/core_surface"
    android:paddingHorizontal="4dp"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/coins_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:textAppearance="@style/TextAppearance.MinimaCore.Caption"
        android:textColor="@color/core_text_mid" />

    <!-- loading / error / empty. Never shown at the same time as the list. -->
    <TextView
        android:id="@+id/coins_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:textAppearance="@style/TextAppearance.MinimaCore.Body"
        android:textColor="@color/core_text_faint" />

    <ListView
        android:id="@+id/coins_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@color/core_surface"
        android:divider="@color/core_outline"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:listSelector="@android:color/transparent" />

    <TextView
        android:id="@+id/coins_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:lineSpacingMultiplier="1.25"
        android:textAppearance="@style/TextAppearance.MinimaCore.Caption"
        android:textColor="@color/core_text_faint" />
</LinearLayout>
