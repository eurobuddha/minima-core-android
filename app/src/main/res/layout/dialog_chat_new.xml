<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newchat_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan their QR code" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="— or paste their address —"
        android:textColor="@color/core_text_faint"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/newchat_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="0x… address"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:inputType="text"
        android:maxLines="2" />

    <EditText
        android:id="@+id/newchat_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Name (optional)"
        android:inputType="textCapWords"
        android:maxLines="1" />
</LinearLayout>
