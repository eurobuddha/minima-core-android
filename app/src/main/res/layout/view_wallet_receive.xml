<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/core_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="Scan to receive" android:tag="l10n:text=l10n_core_wallet_scan"
        android:textAppearance="@style/TextAppearance.MinimaCore.Eyebrow" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:strokeWidth="0dp"
        app:contentPadding="18dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <ImageView
            android:id="@+id/wallet_receive_qrcode"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:contentDescription="Receive QR code" android:tag="l10n:description=l10n_core_wallet_qr" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/wallet_receive_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:textColor="@color/core_text"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallet_receive_copy"
            style="@style/Widget.MinimaCore.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp"
            android:text="Copy" android:tag="l10n:text=l10n_wallet_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallet_receive_changeaddress"
            style="@style/Widget.MinimaCore.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Get Address" android:tag="l10n:text=l10n_core_wallet_get_address" />
    </LinearLayout>
</LinearLayout>

</ScrollView>
