<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:tag="l10n:text=l10n_chat_to_pay_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TO THEIR PAY ADDRESS"
        android:textSize="11sp"
        android:alpha="0.7" />

    <TextView
        android:id="@+id/pay_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

    <EditText
        android:id="@+id/pay_amount"
        android:tag="l10n:hint=l10n_chat_amount_minima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Amount (Minima)"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <TextView
        android:tag="l10n:text=l10n_chat_real_funds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="This sends real Minima from this node's wallet."
        android:textSize="12sp"
        android:alpha="0.7" />
</LinearLayout>
