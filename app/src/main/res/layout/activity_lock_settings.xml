<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/locksettings_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/core_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/core_surface"
        app:titleTextColor="@color/core_text"
        app:titleTextAppearance="@style/TextAppearance.MinimaCore.Title"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App lock"
                android:textAppearance="@style/TextAppearance.MinimaCore.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Require a PIN (and optional fingerprint/face) to open the app. Your node keeps running in the background while the app is locked — only the screen is protected."
                android:textAppearance="@style/TextAppearance.MinimaCore.Body"
                android:textColor="@color/core_text_mid"
                android:lineSpacingMultiplier="1.3" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/lock_switch_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Require a PIN to open the app"
                android:textAppearance="@style/TextAppearance.MinimaCore.Body"
                android:textColor="@color/core_text" />

            <LinearLayout
                android:id="@+id/lock_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/lock_switch_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Use fingerprint / face"
                    android:textAppearance="@style/TextAppearance.MinimaCore.Body"
                    android:textColor="@color/core_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unlock with biometrics. Your PIN always works as a fallback."
                    android:textAppearance="@style/TextAppearance.MinimaCore.Body"
                    android:textSize="12sp"
                    android:textColor="@color/core_text_mid" />

                <TextView style="@style/FormLabel" android:text="Auto-lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lock_autolock"
                    style="@style/Widget.MinimaCore.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="After 1 minute" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="How long the app stays unlocked after you leave it before it locks again."
                    android:textAppearance="@style/TextAppearance.MinimaCore.Body"
                    android:textSize="12sp"
                    android:textColor="@color/core_text_mid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lock_change_pin"
                    style="@style/Widget.MinimaCore.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Change PIN" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
