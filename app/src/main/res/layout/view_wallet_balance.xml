<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet layout for all bears: the "Total balance" block is compact — just the headline (sendable)
  amount, with an expand arrow that reveals the confirmed/locked/unconfirmed/coins breakdown. The
  token list is a drag-reorderable RecyclerView (long-press to move; BalanceView wires the
  ItemTouchHelper). wallet_balance_header / wallet_balance_expand / wallet_balance_recycler are
  declared in values/ids.xml; BalanceView guards on their presence.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/core_bg">

    <!-- ===== Total balance (tap the row to reveal the breakdown) ===== -->
    <LinearLayout
        android:id="@id/wallet_balance_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total balance" android:tag="l10n:text=l10n_core_wallet_total"
            android:textAppearance="@style/TextAppearance.MinimaCore.Caption" />

        <ImageView
            android:id="@id/wallet_balance_expand"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/core_text_faint"
            android:contentDescription="Show balance details" android:tag="l10n:description=l10n_core_wallet_show_details" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/wallet_total_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:textIsSelectable="true"
            android:fontFeatureSettings="tnum"
            android:text="0"
            android:textAppearance="@style/TextAppearance.MinimaCore.Numeral"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="5dp"
            android:text="MINIMA"
            android:textAppearance="@style/TextAppearance.MinimaCore.Eyebrow" />
    </LinearLayout>

    <TextView
        android:id="@+id/wallet_refresh_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.MinimaCore.Caption" />

    <!-- what makes up that number: confirmed / locked / unconfirmed / coin count / staleness.
         Collapsed by default; BalanceView toggles it from the header row above. -->
    <TextView
        android:id="@+id/wallet_balance_breakdown"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:textIsSelectable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.MinimaCore.Caption"
        android:textColor="@color/core_text_faint"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.25" />

    <!-- ===== Send / Receive ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallet_btn_send"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Send" android:tag="l10n:text=l10n_wallet_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallet_btn_receive"
            style="@style/Widget.MinimaCore.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Receive" android:tag="l10n:text=l10n_wallet_receive" />
    </LinearLayout>

    <!-- ===== Tokens ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp"
        android:text="Tokens" android:tag="l10n:text=l10n_core_wallet_tokens"
        android:textAppearance="@style/TextAppearance.MinimaCore.Eyebrow" />

    <!-- Drag-reorderable token list (long-press to move). BalanceView wires the ItemTouchHelper. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/wallet_balance_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/core_bg"
        android:scrollbars="none" />
</LinearLayout>
