<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pm_entropy_root" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pm_entropy_bg">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:tag="pandamonium.app.toolbar">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/pm_entropy_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="ENTROPY" android:textColor="@color/pm_entropy_gold" android:textSize="22sp" android:letterSpacing="0.4" android:textStyle="bold" />
            <TextView android:id="@+id/pm_entropy_btnSound" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="🔊" android:textSize="20sp" android:contentDescription="@string/l10n_entropy_sound" android:tag="l10n:description=l10n_entropy_sound" />
            <TextView android:id="@+id/pm_entropy_btnDemo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:gravity="center" android:alpha="0.55" android:text="🎥" android:textSize="20sp" android:contentDescription="@string/l10n_entropy_demo" android:tag="l10n:description=l10n_entropy_demo" />
        </FrameLayout>
        <TextView android:id="@+id/pm_entropy_demoBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#40FF2D78" android:padding="8dp" android:text="@string/l10n_entropy_demo_banner" android:textColor="@color/pm_entropy_pink" android:textSize="12sp" android:visibility="gone" android:tag="l10n:text=l10n_entropy_demo_banner" />
        <TextView android:id="@+id/pm_entropy_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/l10n_entropy_subtitle" android:textColor="#8A93AD" android:textSize="10sp" android:letterSpacing="0.2" android:tag="l10n:text=l10n_entropy_subtitle" />
        <TextView android:id="@+id/pm_entropy_pairingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#33FFD700" android:padding="8dp" android:text="@string/l10n_explorer_node_retry" android:textColor="@color/pm_entropy_gold" android:textSize="12sp" android:visibility="gone" android:tag="l10n:text=l10n_explorer_node_retry" />
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/pm_entropy_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/pm_entropy_bg" app:tabIndicatorColor="@color/pm_entropy_gold" app:tabSelectedTextColor="@color/pm_entropy_gold" app:tabTextColor="#8A93AD" app:tabMode="scrollable" />
    <androidx.viewpager.widget.ViewPager android:id="@+id/pm_entropy_pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>