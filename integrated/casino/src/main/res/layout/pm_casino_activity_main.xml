<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pm_casino_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pm_casino_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:background="@color/pm_casino_panel" android:tag="pandamonium.app.toolbar">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/pm_casino_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZERO EDGE CASINO" android:textColor="@color/pm_casino_gold" android:textStyle="bold" android:fontFamily="monospace" android:textSize="15sp" android:letterSpacing="0.05" />
            <TextView android:id="@+id/pm_casino_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_casino_provably_fair" android:textColor="@color/pm_casino_cyan" android:textSize="10sp" android:fontFamily="monospace" android:tag="l10n:text=l10n_casino_provably_fair" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/pm_casino_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/pm_casino_gold" android:textStyle="bold" android:fontFamily="monospace" android:textSize="14sp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <View android:id="@+id/pm_casino_liveDot" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="5dp" android:background="@drawable/pm_casino_dot_live" />
                <TextView android:id="@+id/pm_casino_blockNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#0" android:textColor="@color/pm_casino_text" android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/pm_casino_btnCcy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minWidth="48dp" android:minHeight="48dp" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:text="MINIMA" android:textSize="10sp" android:textColor="@color/pm_casino_bg" android:backgroundTint="@color/pm_casino_gold" />
        <Button android:id="@+id/pm_casino_btnSound" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minWidth="48dp" android:minHeight="48dp" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:text="@string/l10n_casino_sound" android:textSize="10sp" android:textColor="@color/pm_casino_bg" android:backgroundTint="@color/pm_casino_cyan" android:tag="l10n:text=l10n_casino_sound" />
    </LinearLayout>
    <TextView android:id="@+id/pm_casino_ticker" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/pm_casino_bg" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/pm_casino_cyan" android:textSize="11sp" android:fontFamily="monospace" android:text="@string/l10n_casino_starting" android:tag="l10n:text=l10n_casino_starting" />
    <TextView android:id="@+id/pm_casino_pairingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="12dp" android:text="@string/l10n_explorer_node_retry" android:textColor="@color/pm_casino_bg" android:background="@color/pm_casino_gold" android:textSize="12sp" android:tag="l10n:text=l10n_explorer_node_retry" />
    <TextView android:id="@+id/pm_casino_timeoutBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:padding="12dp" android:visibility="gone" android:focusable="true" android:textColor="@color/pm_casino_bg" android:background="@color/pm_casino_gold" android:textSize="12sp" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/pm_casino_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/pm_casino_panel" app:tabIndicatorColor="@color/pm_casino_gold" app:tabSelectedTextColor="@color/pm_casino_gold" app:tabTextColor="@color/pm_casino_text" app:tabMode="scrollable" />
    <androidx.viewpager.widget.ViewPager android:id="@+id/pm_casino_pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>