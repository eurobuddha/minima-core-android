<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pm_utxo_ux_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_your_address" android:textColor="@color/pm_utxo_ux_subtext" android:textSize="13sp" android:layout_marginBottom="12dp" android:tag="l10n:text=l10n_utxo_your_address" />
        <ImageView android:id="@+id/pm_utxo_rcvQr" android:layout_width="240dp" android:layout_height="240dp" android:background="@color/pm_utxo_white" android:padding="8dp" />
        <TextView android:id="@+id/pm_utxo_rcvAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:background="@color/pm_utxo_ux_card" android:textColor="@color/pm_utxo_ux_text" android:textSize="13sp" android:fontFamily="monospace" android:textIsSelectable="true" android:gravity="center" />
        <Button android:id="@+id/pm_utxo_rcvCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/l10n_utxo_copy_address" android:backgroundTint="@color/pm_utxo_ux_accent" android:textColor="@color/pm_utxo_black" android:tag="l10n:text=l10n_utxo_copy_address" />
        <Button android:id="@+id/pm_utxo_rcvRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/l10n_utxo_get_address" style="?attr/materialButtonOutlinedStyle" android:tag="l10n:text=l10n_utxo_get_address" />
    </LinearLayout>
</ScrollView>