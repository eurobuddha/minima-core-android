<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pm_utxo_ux_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_from_selected" android:textColor="@color/pm_utxo_ux_subtext" android:textSize="11sp" android:letterSpacing="0.1" android:layout_marginBottom="6dp" android:tag="l10n:text=l10n_utxo_from_selected" />
        <LinearLayout android:id="@+id/pm_utxo_sendFromList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/pm_utxo_ux_card" android:padding="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_recipient" android:textColor="@color/pm_utxo_ux_subtext" android:textSize="13sp" android:layout_marginTop="18dp" android:layout_marginBottom="5dp" android:tag="l10n:text=l10n_utxo_recipient" />
        <EditText android:id="@+id/pm_utxo_sendAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_utxo_address_hint" android:textColorHint="@color/pm_utxo_ux_subtext" android:textColor="@color/pm_utxo_ux_text" android:background="@color/pm_utxo_ux_input" android:padding="12dp" android:inputType="text" android:maxLines="2" android:fontFamily="monospace" android:textSize="13sp" android:tag="l10n:hint=l10n_utxo_address_hint" />
        <TextView android:id="@+id/pm_utxo_sendAddrNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:layout_marginBottom="5dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_utxo_amount" android:textColor="@color/pm_utxo_ux_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_utxo_amount" />
            <TextView android:id="@+id/pm_utxo_maxBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_max" android:textColor="@color/pm_utxo_ux_accent" android:textSize="11sp" android:letterSpacing="0.1" android:padding="4dp" android:tag="l10n:text=l10n_utxo_max" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
        </LinearLayout>
        <EditText android:id="@+id/pm_utxo_sendAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.0" android:textColorHint="@color/pm_utxo_ux_subtext" android:textColor="@color/pm_utxo_ux_text" android:background="@color/pm_utxo_ux_input" android:padding="12dp" android:inputType="numberDecimal" android:fontFamily="monospace" android:textSize="13sp" />
        <TextView android:id="@+id/pm_utxo_sendAmountNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:layout_marginBottom="5dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_utxo_change_to" android:textColor="@color/pm_utxo_ux_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_utxo_change_to" />
            <TextView android:id="@+id/pm_utxo_nextBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_next" android:textColor="@color/pm_utxo_ux_accent" android:textSize="11sp" android:letterSpacing="0.1" android:padding="4dp" android:tag="l10n:text=l10n_utxo_next" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
        </LinearLayout>
        <EditText android:id="@+id/pm_utxo_sendChange" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mx…" android:textColorHint="@color/pm_utxo_ux_subtext" android:textColor="@color/pm_utxo_ux_text" android:background="@color/pm_utxo_ux_input" android:padding="12dp" android:inputType="text" android:maxLines="2" android:fontFamily="monospace" android:textSize="13sp" />
        <TextView android:id="@+id/pm_utxo_sendChangeNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_burn_label" android:textColor="@color/pm_utxo_ux_subtext" android:textSize="13sp" android:layout_marginTop="14dp" android:layout_marginBottom="5dp" android:tag="l10n:text=l10n_utxo_burn_label" />
        <EditText android:id="@+id/pm_utxo_sendBurn" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0" android:textColorHint="@color/pm_utxo_ux_subtext" android:textColor="@color/pm_utxo_ux_text" android:background="@color/pm_utxo_ux_input" android:padding="12dp" android:inputType="numberDecimal" android:fontFamily="monospace" android:textSize="13sp" />
        <TextView android:id="@+id/pm_utxo_sendBurnNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <Button android:id="@+id/pm_utxo_previewBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/l10n_utxo_preview" android:backgroundTint="@color/pm_utxo_ux_accent" android:textColor="@color/pm_utxo_black" android:tag="l10n:text=l10n_utxo_preview" />
        <TextView android:id="@+id/pm_utxo_sendStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="10dp" android:textSize="13sp" android:gravity="center" android:visibility="gone" />
    </LinearLayout>
</ScrollView>