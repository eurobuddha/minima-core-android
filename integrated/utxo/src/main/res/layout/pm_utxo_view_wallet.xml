<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pm_utxo_ux_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:background="@color/pm_utxo_ux_card" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/pm_utxo_selCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_pick_coins" android:textColor="@color/pm_utxo_ux_text" android:textSize="13sp" android:tag="l10n:text=l10n_utxo_pick_coins" />
            <TextView android:id="@+id/pm_utxo_selTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/pm_utxo_ux_accent" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/pm_utxo_toolsBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:insetLeft="2dp" android:insetRight="2dp" android:text="@string/l10n_utxo_tools" style="?attr/materialButtonOutlinedStyle" android:layout_weight="1.4" android:minHeight="48dp" android:textSize="14sp" android:tag="l10n:text=l10n_utxo_tools" />
            <Button android:id="@+id/pm_utxo_clearBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:insetLeft="2dp" android:insetRight="2dp" android:text="@string/l10n_utxo_clear" style="?attr/materialButtonOutlinedStyle" android:layout_weight="1" android:minHeight="48dp" android:textSize="14sp" android:tag="l10n:text=l10n_utxo_clear" />
            <Button android:id="@+id/pm_utxo_sendBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:minWidth="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:insetLeft="2dp" android:insetRight="0dp" android:text="@string/l10n_utxo_send_action" android:backgroundTint="@color/pm_utxo_ux_accent" android:textColor="@color/pm_utxo_black" android:layout_weight="1.3" android:minHeight="48dp" android:textSize="14sp" android:tag="l10n:text=l10n_utxo_send_action" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/pm_utxo_walletStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textSize="13sp" android:gravity="center" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/pm_utxo_walletContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" />
    </ScrollView>
</LinearLayout>