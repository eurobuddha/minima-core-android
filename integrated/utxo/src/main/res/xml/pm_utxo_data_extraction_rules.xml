<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup/transfer rules. Cloud backup AND device transfer (Smart Switch) are
   governed separately — both are excluded.

   Nothing in this app needs to leave the device, and nothing here should survive a reinstall onto a node
   with different keys. allowBackup="false" already disables this; the excludes are explicit so the intent
   survives anyone flipping that flag back. What was being carried:
   utxo_history.db (a transaction cache), the airdrop/distribute job state and design prefs, plus the shared
         minima_api_prefs node pairing token. No keys are stored — the wallet is the node's — but a restored
         distribute job and a stale pairing token both belong to a node this install may no longer be talking to
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
