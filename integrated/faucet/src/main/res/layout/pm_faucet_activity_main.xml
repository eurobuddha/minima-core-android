<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/pm_faucet_main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pm_faucet_faucet_bg" android:fillViewport="true" tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:tag="pandamonium.app.toolbar">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/l10n_faucet_brand" android:textColor="@color/pm_faucet_faucet_accent" android:textSize="12sp" android:letterSpacing="0.15" android:layout_marginTop="0dp" android:tag="l10n:text=l10n_faucet_brand" android:layout_weight="1" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pm_faucet_pairingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/pm_faucet_faucet_banner" android:padding="16dp" android:layout_marginBottom="20dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/l10n_faucet_node_not_ready" android:textColor="@color/pm_faucet_faucet_accent" android:textStyle="bold" android:textSize="15sp" android:tag="l10n:text=l10n_faucet_node_not_ready" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/l10n_faucet_node_help" android:textColor="@color/pm_faucet_faucet_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_faucet_node_help" />
            <Button android:id="@+id/pm_faucet_openNodeBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/l10n_faucet_open_node" android:tag="l10n:text=l10n_faucet_open_node" android:minHeight="48dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_faucet_heading" android:textColor="@color/pm_faucet_faucet_text" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="8dp" android:tag="l10n:text=l10n_faucet_heading" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/l10n_faucet_intro" android:textColor="@color/pm_faucet_faucet_subtext" android:textSize="14sp" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="28dp" android:tag="l10n:text=l10n_faucet_intro" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/l10n_faucet_address" android:textColor="@color/pm_faucet_faucet_subtext" android:textSize="13sp" android:layout_marginBottom="6dp" android:tag="l10n:text=l10n_faucet_address" />
        <EditText android:id="@+id/pm_faucet_addressInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_faucet_hint" android:textColorHint="@color/pm_faucet_faucet_subtext" android:textColor="@color/pm_faucet_faucet_text" android:background="@color/pm_faucet_faucet_input" android:padding="14dp" android:inputType="text" android:maxLines="2" android:tag="l10n:hint=l10n_faucet_hint" android:minHeight="48dp" />
        <Button android:id="@+id/pm_faucet_getAddrBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/l10n_faucet_get_address" style="?attr/materialButtonOutlinedStyle" android:tag="l10n:text=l10n_faucet_get_address" android:minHeight="48dp" />
        <Button android:id="@+id/pm_faucet_requestBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/l10n_faucet_request" android:backgroundTint="@color/pm_faucet_faucet_accent" android:textColor="@color/pm_faucet_black" android:tag="l10n:text=l10n_faucet_request" android:minHeight="48dp" />
        <TextView android:id="@+id/pm_faucet_statusBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="14dp" android:textSize="14sp" android:gravity="center" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/l10n_faucet_help" android:textColor="@color/pm_faucet_faucet_subtext" android:textSize="12sp" android:gravity="center" android:tag="l10n:text=l10n_faucet_help" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/l10n_faucet_footer" android:textColor="@color/pm_faucet_faucet_subtext" android:textSize="11sp" android:tag="l10n:text=l10n_faucet_footer" />
    </LinearLayout>
</ScrollView>
