<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup/transfer rules. Cloud backup is already off via allowBackup="false", but DEVICE
   TRANSFER (Smart Switch and friends) is governed separately here — so it is excluded explicitly too.

   Same reason as backup_rules.xml: the prefs carry the swap identity and the databases carry `secrets`
   (HTLC claim preimages). Restoring them onto a phone whose node has a different seed re-plants an
   identity that node cannot sign for — the failure this app now halts on — and moves spend-authorising
   material off-device. A reinstall (or a new phone) must start clean and re-derive from the node.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
