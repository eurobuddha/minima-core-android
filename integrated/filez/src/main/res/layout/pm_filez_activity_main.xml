<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pm_filez_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0A0A0F">
    <LinearLayout android:id="@+id/pm_filez_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#15151F" android:paddingStart="18dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:tag="pandamonium.app.toolbar">
        <TextView android:id="@+id/pm_filez_backBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" android:textColor="#F7931A" android:textSize="22sp" android:paddingEnd="12dp" android:visibility="gone" android:contentDescription="@string/l10n_filez_up" android:tag="l10n:description=l10n_filez_up" />
        <TextView android:id="@+id/pm_filez_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Filez" android:textColor="#F7931A" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" android:ellipsize="start" android:letterSpacing="0.02" />
        <TextView android:id="@+id/pm_filez_refreshBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⟳" android:textColor="#F7931A" android:textSize="18sp" android:padding="6dp" android:contentDescription="@string/l10n_filez_refresh" android:tag="l10n:description=l10n_filez_refresh" />
        <TextView android:id="@+id/pm_filez_menuBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⋮" android:textColor="#9A9AA8" android:textSize="20sp" android:paddingStart="10dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:contentDescription="@string/l10n_filez_menu" android:tag="l10n:description=l10n_filez_menu" />
    </LinearLayout>
    <TextView android:id="@+id/pm_filez_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#15151F" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="10dp" android:text="@string/l10n_filez_loading" android:textColor="#9A9AA8" android:textSize="12sp" android:tag="l10n:text=l10n_filez_loading" />
    <LinearLayout android:id="@+id/pm_filez_pairingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#15151F" android:padding="16dp" android:visibility="gone">
        <TextView android:id="@+id/pm_filez_pairingTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/l10n_filez_not_enabled" android:textColor="#F7931A" android:textStyle="bold" android:textSize="15sp" android:tag="l10n:text=l10n_filez_not_enabled" />
        <TextView android:id="@+id/pm_filez_pairingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/l10n_explorer_node_retry" android:textColor="#9A9AA8" android:textSize="13sp" android:tag="l10n:text=l10n_explorer_node_retry" />
        <Button android:id="@+id/pm_filez_openNodeBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/l10n_filez_open_core" android:tag="l10n:text=l10n_filez_open_core" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pm_filez_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
</LinearLayout>