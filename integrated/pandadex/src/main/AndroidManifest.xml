<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <queries>
        <package android:name="com.eurobuddha.minimacore" />
        <package android:name="com.eurobuddha.minimablock" />
        <package android:name="com.eurobuddha.pandamonium" />
    </queries>
    <application>
        <activity android:name="com.eurobuddha.pandadex.MainActivity" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation" android:theme="@style/pm_pandadex_Theme.PandaDex">
            </activity>
        <service android:name="com.eurobuddha.pandadex.DexKeepAliveService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse|dataSync">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Watches the on-chain order book to detect fills and keep the user's GTC orders alive while the app is closed" />
        </service>
        <receiver android:name="com.eurobuddha.pandadex.HeartbeatReceiver" android:exported="false" />
        <receiver android:name="com.eurobuddha.pandadex.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>