<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules. This file CANNOT express the cloud-vs-transfer split that
   data_extraction_rules.xml uses on Android 12+, and the dangerous file here is the command history
   (`terminalide.db` — verbatim, unredacted, so it can contain seed phrases and vault passwords typed into
   the terminal). On old devices we therefore back up NOTHING rather than risk that reaching a cloud.

   Consequence, accepted deliberately: on API < 31 the user's own scripts (`scripts.db`) are not carried by
   Auto Backup either. Android 12+ device transfer still carries them — see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
