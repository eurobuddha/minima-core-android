<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pm_terminalide_editor_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pm_terminalide_ide_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/pm_terminalide_editor_toolbar" app:titleTextColor="@color/pm_terminalide_white" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorPrimary" android:minHeight="?attr/actionBarSize" android:theme="?attr/actionBarTheme" />
    <EditText android:id="@+id/pm_terminalide_editor_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="@string/l10n_terminal_editor_name" android:background="@color/pm_terminalide_ide_bg_light" android:tag="l10n:hint=l10n_terminal_editor_name" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/pm_terminalide_editor_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="10" android:gravity="top|start" android:padding="12dp" android:typeface="monospace" android:textSize="13sp" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="@string/l10n_terminal_editor_source_hint" android:background="@color/pm_terminalide_ide_bg" android:inputType="textMultiLine|textNoSuggestions" android:tag="l10n:hint=l10n_terminal_editor_source_hint" />
            <TextView android:id="@+id/pm_terminalide_editor_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:typeface="monospace" android:textSize="12sp" android:textColor="@color/pm_terminalide_ide_dim" android:background="@color/pm_terminalide_ide_bg_light" />
            <Button android:id="@+id/pm_terminalide_editor_toggle_config" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/pm_terminalide_ide_accent" android:text="@string/l10n_terminal_editor_inputs_closed" android:tag="l10n:text=l10n_terminal_editor_inputs_closed" />
            <LinearLayout android:id="@+id/pm_terminalide_editor_runconfig" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone">
                <EditText android:id="@+id/pm_terminalide_editor_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:typeface="monospace" android:textSize="12sp" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="state e.g. {&quot;0&quot;:&quot;0xFF..&quot;,&quot;6&quot;:&quot;1&quot;}" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/pm_terminalide_editor_prevstate" android:layout_width="match_parent" android:layout_height="wrap_content" android:typeface="monospace" android:textSize="12sp" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="prevstate e.g. {&quot;0&quot;:&quot;0xFF..&quot;,&quot;6&quot;:&quot;0&quot;}" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/pm_terminalide_editor_globals" android:layout_width="match_parent" android:layout_height="wrap_content" android:typeface="monospace" android:textSize="12sp" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="globals e.g. {&quot;@COINAGE&quot;:&quot;64&quot;,&quot;@AMOUNT&quot;:&quot;10&quot;}" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/pm_terminalide_editor_signatures" android:layout_width="match_parent" android:layout_height="wrap_content" android:typeface="monospace" android:textSize="12sp" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="signatures e.g. [&quot;0xFF..&quot;]" android:inputType="text|textNoSuggestions" />
            </LinearLayout>
            <TextView android:id="@+id/pm_terminalide_editor_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:typeface="monospace" android:textSize="12sp" android:textIsSelectable="true" android:textColor="@color/pm_terminalide_ide_dim" android:text="@string/l10n_terminal_editor_initial_help" android:tag="l10n:text=l10n_terminal_editor_initial_help" />
        </LinearLayout>
    </ScrollView>
    <HorizontalScrollView android:id="@+id/pm_terminalide_editor_chipscroller" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:id="@+id/pm_terminalide_editor_chiprow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/pm_terminalide_ide_bg_light" android:padding="4dp">
        <Button android:id="@+id/pm_terminalide_editor_check" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="@string/l10n_terminal_editor_check" android:tag="l10n:text=l10n_terminal_editor_check" />
        <Button android:id="@+id/pm_terminalide_editor_run" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="@string/l10n_terminal_run" android:tag="l10n:text=l10n_terminal_run" />
        <Button android:id="@+id/pm_terminalide_editor_deploy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/l10n_terminal_editor_deploy" android:tag="l10n:text=l10n_terminal_editor_deploy" />
    </LinearLayout>
</LinearLayout>