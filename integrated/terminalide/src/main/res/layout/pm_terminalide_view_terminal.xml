<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pm_terminalide_ide_bg">
    <com.eurobuddha.terminalide.terminal.SelectionScrollView android:id="@+id/pm_terminalide_terminal_scroller" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:fillViewport="true">
        <LinearLayout android:id="@+id/pm_terminalide_terminal_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="bottom" />
    </com.eurobuddha.terminalide.terminal.SelectionScrollView>
    <LinearLayout android:id="@+id/pm_terminalide_terminal_selbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/pm_terminalide_ide_bg_light" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_terminal_ide_select_bar" android:textSize="11sp" android:typeface="monospace" android:textColor="@color/pm_terminalide_ide_dim" android:tag="l10n:text=l10n_terminal_ide_select_bar" />
        <TextView android:id="@+id/pm_terminalide_terminal_sel_copyall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:clickable="true" android:focusable="true" android:text="@string/l10n_terminal_ide_copy_all" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/pm_terminalide_ide_accent" android:tag="l10n:text=l10n_terminal_ide_copy_all" />
        <TextView android:id="@+id/pm_terminalide_terminal_sel_export" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:clickable="true" android:focusable="true" android:text="@string/l10n_terminal_ide_export" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/pm_terminalide_ide_accent" android:tag="l10n:text=l10n_terminal_ide_export" />
        <TextView android:id="@+id/pm_terminalide_terminal_sel_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:clickable="true" android:focusable="true" android:text="@string/l10n_terminal_ide_done" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/pm_terminalide_ide_warn" android:tag="l10n:text=l10n_terminal_ide_done" />
    </LinearLayout>
    <TextView android:id="@+id/pm_terminalide_terminal_paramhint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="12sp" android:typeface="monospace" android:textColor="@color/pm_terminalide_ide_dim" android:background="@color/pm_terminalide_ide_bg_light" android:visibility="gone" />
    <ScrollView android:id="@+id/pm_terminalide_terminal_dropdown_scroller" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/pm_terminalide_ide_bg_light" android:scrollbars="vertical" android:visibility="gone">
        <LinearLayout android:id="@+id/pm_terminalide_terminal_dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/pm_terminalide_ide_bg_light" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/pm_terminalide_terminal_hist_up" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:clickable="true" android:focusable="true" android:text="▲" android:textSize="18sp" android:textColor="@color/pm_terminalide_ide_accent" android:contentDescription="@string/l10n_terminal_ide_older_command" android:tag="l10n:description=l10n_terminal_ide_older_command" />
        <TextView android:id="@+id/pm_terminalide_terminal_hist_down" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:clickable="true" android:focusable="true" android:text="▼" android:textSize="18sp" android:textColor="@color/pm_terminalide_ide_accent" android:contentDescription="@string/l10n_terminal_ide_newer_command" android:tag="l10n:description=l10n_terminal_ide_newer_command" />
        <TextView android:id="@+id/pm_terminalide_terminal_tab" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:clickable="true" android:focusable="true" android:text="⇥" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pm_terminalide_ide_accent" android:visibility="gone" android:contentDescription="@string/l10n_terminal_ide_accept" android:tag="l10n:description=l10n_terminal_ide_accept" />
        <com.eurobuddha.terminalide.terminal.CaretEditText android:id="@+id/pm_terminalide_terminal_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:imeOptions="actionDone" android:typeface="monospace" android:textSize="14sp" android:textColor="@color/pm_terminalide_ide_text" android:textColorHint="@color/pm_terminalide_ide_dim" android:hint="@string/l10n_terminal_ide_command_hint" android:inputType="text|textNoSuggestions" android:tag="l10n:hint=l10n_terminal_ide_command_hint" />
        <TextView android:id="@+id/pm_terminalide_terminal_fav" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:clickable="true" android:focusable="true" android:text="★" android:textSize="18sp" android:textColor="@color/pm_terminalide_ide_warn" android:contentDescription="@string/l10n_terminal_ide_favorite_button" android:tag="l10n:description=l10n_terminal_ide_favorite_button" />
        <Button android:id="@+id/pm_terminalide_terminal_send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_terminal_run" android:tag="l10n:text=l10n_terminal_run" />
    </LinearLayout>
</LinearLayout>