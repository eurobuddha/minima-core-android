<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
    <EditText android:id="@+id/pm_terminalide_out_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_terminal_txn_amount_hint" android:inputType="numberDecimal" android:tag="l10n:hint=l10n_terminal_txn_amount_hint" />
    <EditText android:id="@+id/pm_terminalide_out_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_terminal_txn_address_hint" android:inputType="text|textNoSuggestions" android:tag="l10n:hint=l10n_terminal_txn_address_hint" />
    <EditText android:id="@+id/pm_terminalide_out_tokenid" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_terminal_txn_token_hint" android:inputType="text|textNoSuggestions" android:tag="l10n:hint=l10n_terminal_txn_token_hint" />
    <CheckBox android:id="@+id/pm_terminalide_out_storestate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_terminal_txn_storestate" android:tag="l10n:text=l10n_terminal_txn_storestate" />
</LinearLayout>