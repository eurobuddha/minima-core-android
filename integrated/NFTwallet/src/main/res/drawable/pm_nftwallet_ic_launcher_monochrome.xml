<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome (themed-icon) variant of the Minima "M" mark, taken verbatim from the official Wallet MiniDapp's icon.svg (wallet-3.1.3,
  viewBox 542x527) so the shape is the real brand geometry rather than a redraw.

  Scaled to ~62 of the 108dp canvas and centred, which keeps the whole mark inside the adaptive
  icon's 66dp safe zone — nothing is clipped by a circular, squircle or rounded-square mask.
    scale     62 / 542 = 0.1144
    translate (108 - 62) / 2 = 23  ·  (108 - 527*0.1144) / 2 = 23.8
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.1144"
        android:scaleY="0.1144"
        android:translateX="23"
        android:translateY="23.8">

        <path
            android:fillColor="#000000"
            android:pathData="M208.495,209.087 L299.726,244.914 L355.593,222.966 L375.123,139.006 L299.726,168.62 L156.405,112.337 L104.316,336.272 L186.406,304.033 Z" />
        <path
            android:fillColor="#000000"
            android:pathData="M355.594,222.966 L333.505,317.913 L242.271,282.086 L186.406,304.036 L166.876,387.996 L242.271,358.38 L385.593,414.663 L437.681,190.729 Z" />
    </group>
</vector>
