<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/pm_nftwallet_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pm_nftwallet_ux_bg" tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="10dp" android:tag="pandamonium.app.toolbar">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/pm_nftwallet_brandTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NFT Wallet" android:textColor="@color/pm_nftwallet_ux_accent" android:textStyle="bold" android:textSize="17sp" />
            <TextView android:id="@+id/pm_nftwallet_brandSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_nft_wallet_brand_help" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="9sp" android:letterSpacing="0.15" android:tag="l10n:text=l10n_nft_wallet_brand_help" />
        </LinearLayout>
        <TextView android:id="@+id/pm_nftwallet_designToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◐ STYLE" android:textColor="@color/pm_nftwallet_ux_accent" android:textSize="11sp" android:letterSpacing="0.08" android:padding="6dp" android:layout_marginEnd="2dp" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
        <TextView android:id="@+id/pm_nftwallet_settingsBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" android:textColor="@color/pm_nftwallet_ux_accent" android:textSize="15sp" android:padding="6dp" android:layout_marginEnd="6dp" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
        <TextView android:id="@+id/pm_nftwallet_blockNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#—" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pm_nftwallet_pairingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/pm_nftwallet_ux_banner" android:padding="16dp" android:visibility="gone">
        <TextView android:id="@+id/pm_nftwallet_pairingTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/l10n_utxo_node_not_ready" android:textColor="@color/pm_nftwallet_ux_accent" android:textStyle="bold" android:textSize="15sp" android:tag="l10n:text=l10n_utxo_node_not_ready" />
        <TextView android:id="@+id/pm_nftwallet_pairingBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/l10n_explorer_node_retry" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_explorer_node_retry" />
        <Button android:id="@+id/pm_nftwallet_openNodeBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/l10n_filez_open_core" android:tag="l10n:text=l10n_filez_open_core" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/pm_nftwallet_tabScrollLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="‹" android:textSize="22sp" android:gravity="center" android:minWidth="48dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone" android:minHeight="48dp" />
        <com.google.android.material.tabs.TabLayout android:id="@+id/pm_nftwallet_tabs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:tabMode="scrollable" app:tabGravity="fill" app:tabIndicatorColor="@color/pm_nftwallet_ux_accent" app:tabSelectedTextColor="@color/pm_nftwallet_ux_accent" app:tabTextColor="@color/pm_nftwallet_ux_subtext" />
        <TextView android:id="@+id/pm_nftwallet_tabScrollRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="›" android:textSize="22sp" android:gravity="center" android:minWidth="48dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone" android:minHeight="48dp" />
    </LinearLayout>
    <androidx.viewpager.widget.ViewPager android:id="@+id/pm_nftwallet_pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>