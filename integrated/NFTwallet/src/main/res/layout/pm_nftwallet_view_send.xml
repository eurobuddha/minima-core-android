<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pm_nftwallet_ux_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:id="@+id/pm_nftwallet_sendModeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
            <TextView android:id="@+id/pm_nftwallet_modeQuickBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_nft_send_quick_mode" android:gravity="center" android:padding="9dp" android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold" android:tag="l10n:text=l10n_nft_send_quick_mode" android:minHeight="48dp" android:minWidth="48dp" />
            <TextView android:id="@+id/pm_nftwallet_modeCoinsBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_nft_send_coin_mode" android:gravity="center" android:padding="9dp" android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold" android:tag="l10n:text=l10n_nft_send_coin_mode" android:minHeight="48dp" android:minWidth="48dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pm_nftwallet_sendTokenBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_wallet_token" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:layout_marginBottom="5dp" android:tag="l10n:text=l10n_wallet_token" />
            <LinearLayout android:id="@+id/pm_nftwallet_sendTokenRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/pm_nftwallet_ux_input" android:padding="12dp">
                <TextView android:id="@+id/pm_nftwallet_sendTokenLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Minima" android:textColor="@color/pm_nftwallet_ux_text" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/pm_nftwallet_sendTokenBal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▾" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/pm_nftwallet_sendFromBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_from_selected" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="11sp" android:letterSpacing="0.1" android:layout_marginBottom="6dp" android:tag="l10n:text=l10n_utxo_from_selected" />
            <LinearLayout android:id="@+id/pm_nftwallet_sendFromList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/pm_nftwallet_ux_card" android:padding="12dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="5dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_utxo_recipient" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_utxo_recipient" />
            <TextView android:id="@+id/pm_nftwallet_scanBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_eth_wallet_scan" android:textColor="@color/pm_nftwallet_ux_accent" android:textSize="11sp" android:letterSpacing="0.1" android:padding="4dp" android:tag="l10n:text=l10n_eth_wallet_scan" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
        </LinearLayout>
        <EditText android:id="@+id/pm_nftwallet_sendAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/l10n_utxo_address_hint" android:textColorHint="@color/pm_nftwallet_ux_subtext" android:textColor="@color/pm_nftwallet_ux_text" android:background="@color/pm_nftwallet_ux_input" android:padding="12dp" android:inputType="text" android:maxLines="2" android:fontFamily="monospace" android:textSize="13sp" android:tag="l10n:hint=l10n_utxo_address_hint" />
        <TextView android:id="@+id/pm_nftwallet_sendAddrNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:layout_marginBottom="5dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_utxo_amount" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_utxo_amount" />
            <TextView android:id="@+id/pm_nftwallet_maxBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_max" android:textColor="@color/pm_nftwallet_ux_accent" android:textSize="11sp" android:letterSpacing="0.1" android:padding="4dp" android:tag="l10n:text=l10n_utxo_max" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
        </LinearLayout>
        <EditText android:id="@+id/pm_nftwallet_sendAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.0" android:textColorHint="@color/pm_nftwallet_ux_subtext" android:textColor="@color/pm_nftwallet_ux_text" android:background="@color/pm_nftwallet_ux_input" android:padding="12dp" android:inputType="numberDecimal" android:fontFamily="monospace" android:textSize="13sp" />
        <TextView android:id="@+id/pm_nftwallet_sendAmountNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/pm_nftwallet_sendSplitBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_nft_send_split_label" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:layout_marginTop="14dp" android:layout_marginBottom="5dp" android:tag="l10n:text=l10n_nft_send_split_label" />
            <EditText android:id="@+id/pm_nftwallet_sendSplit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="1" android:textColorHint="@color/pm_nftwallet_ux_subtext" android:textColor="@color/pm_nftwallet_ux_text" android:background="@color/pm_nftwallet_ux_input" android:padding="12dp" android:inputType="number" android:fontFamily="monospace" android:textSize="13sp" />
            <TextView android:id="@+id/pm_nftwallet_sendSplitNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pm_nftwallet_sendChangeBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:layout_marginBottom="5dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/l10n_utxo_change_to" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:tag="l10n:text=l10n_utxo_change_to" />
                <TextView android:id="@+id/pm_nftwallet_nextBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_next" android:textColor="@color/pm_nftwallet_ux_accent" android:textSize="11sp" android:letterSpacing="0.1" android:padding="4dp" android:tag="l10n:text=l10n_utxo_next" android:minHeight="48dp" android:minWidth="48dp" android:gravity="center" />
            </LinearLayout>
            <EditText android:id="@+id/pm_nftwallet_sendChange" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mx…" android:textColorHint="@color/pm_nftwallet_ux_subtext" android:textColor="@color/pm_nftwallet_ux_text" android:background="@color/pm_nftwallet_ux_input" android:padding="12dp" android:inputType="text" android:maxLines="2" android:fontFamily="monospace" android:textSize="13sp" />
            <TextView android:id="@+id/pm_nftwallet_sendChangeNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/l10n_utxo_burn_label" android:textColor="@color/pm_nftwallet_ux_subtext" android:textSize="13sp" android:layout_marginTop="14dp" android:layout_marginBottom="5dp" android:tag="l10n:text=l10n_utxo_burn_label" />
        <EditText android:id="@+id/pm_nftwallet_sendBurn" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0" android:textColorHint="@color/pm_nftwallet_ux_subtext" android:textColor="@color/pm_nftwallet_ux_text" android:background="@color/pm_nftwallet_ux_input" android:padding="12dp" android:inputType="numberDecimal" android:fontFamily="monospace" android:textSize="13sp" />
        <TextView android:id="@+id/pm_nftwallet_sendBurnNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
        <Button android:id="@+id/pm_nftwallet_previewBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/l10n_utxo_preview" android:backgroundTint="@color/pm_nftwallet_ux_accent" android:textColor="@color/pm_nftwallet_black" android:tag="l10n:text=l10n_utxo_preview" />
        <TextView android:id="@+id/pm_nftwallet_sendStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="10dp" android:textSize="13sp" android:gravity="center" android:visibility="gone" />
    </LinearLayout>
</ScrollView>