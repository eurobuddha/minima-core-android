<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   Nothing in this app needs to leave the device, and nothing here should survive a reinstall onto a node
   with different keys. allowBackup="false" already disables this; the excludes are explicit so the intent
   survives anyone flipping that flag back. What was being carried:
   nftwallet_distribute — an IN-FLIGHT AIRDROP JOB persisted across restarts (DistributeJob.java:77-95).
         Resuming a restored job against a different node could re-send or mis-send tokens. Plus the collections
         catalog, pending-coin map and the shared minima_api_prefs pairing token
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
