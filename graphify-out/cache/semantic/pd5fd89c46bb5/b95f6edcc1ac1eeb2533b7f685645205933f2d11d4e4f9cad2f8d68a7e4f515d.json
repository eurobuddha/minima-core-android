{"nodes": [{"id": "h2_verifyerror_fix", "label": "H2 VerifyError Fix write-up", "file_type": "document", "source_file": "H2_VERIFYERROR_FIX.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "h2_verifyerror_fix_h2_downgrade_2_1_214", "label": "H2 dependency downgrade 2.4.240 -> 2.1.214", "file_type": "rationale", "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Fix section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2.1.214 is the last H2 2.x release whose SHA256 bytecode verifies cleanly on strict ART builds (e.g. Samsung); minima.jar bundles zero org/h2 classes, so the offending class comes solely from the gradle dependency and a one-line pin is a complete fix. Any future H2 upgrade must be verified on strict ARTs first."}, {"id": "h2_verifyerror_fix_art_verifyerror", "label": "ART VerifyError kills node at boot (H2 2.4.240)", "file_type": "concept", "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Root cause section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android's ART bytecode verifier rejects H2 2.4.240's SHA256.getPBKDF2; the node opens its H2 DB with a password (ConnectionInfo.hashPassword -> SHA256.getPBKDF2), so the VerifyError kills the node's main thread at boot while the wallet UI hangs on 'Syncing Minima Wallet..' forever."}, {"id": "h2_verifyerror_fix_sha256_getpbkdf2", "label": "org.h2.security.SHA256.getPBKDF2", "file_type": "code", "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Root cause stack trace", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "h2_verifyerror_fix", "target": "h2_verifyerror_fix_h2_downgrade_2_1_214", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Fix section", "weight": 1.0}, {"source": "h2_verifyerror_fix", "target": "h2_verifyerror_fix_art_verifyerror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Root cause section", "weight": 1.0}, {"source": "h2_verifyerror_fix_art_verifyerror", "target": "h2_verifyerror_fix_sha256_getpbkdf2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Root cause stack trace", "weight": 1.0}, {"source": "h2_verifyerror_fix_h2_downgrade_2_1_214", "target": "h2_verifyerror_fix_art_verifyerror", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "H2_VERIFYERROR_FIX.md", "source_location": "Fix section (downgrade resolves the VerifyError)", "weight": 1.0}], "hyperedges": []}