{"nodes": [{"id": "claude_versioning_guardrail", "label": "Versioning guardrail \u2014 every code change ships with a version bump", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Versioning guardrail section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real funds, real chain: every committed state must be distinct, reversible and trackable. One logical change = one version = one commit = one push; docs/config-only commits need no bump."}, {"id": "claude_pre_commit_version_hook", "label": "Pre-commit version-bump hook (.githooks/pre-commit)", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "Versioning guardrail section", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_pre_commit_version_hook", "target": "claude_versioning_guardrail", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Versioning guardrail section", "weight": 1.0}], "hyperedges": []}